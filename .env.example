# Kick Developer App credentials
KICK_CLIENT_ID=your_client_id
KICK_CLIENT_SECRET=your_client_secret
# Must exactly match the Redirect URL configured in the Kick Developer Portal
KICK_REDIRECT_URI=http://localhost:3000/oauth/callback
# Random 32+ byte secret, base64 is fine
APP_ENCRYPTION_KEY=replace_with_a_long_random_secret
PORT=3000
